<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vallegrande.edu.pe.tutawayta.controller.PedidoController"
            styleClass="root-module">

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Label text="🛒  Gestión de Pedidos" styleClass="top-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="🔍  Buscar pedido..." styleClass="txt-buscar" prefWidth="220"/>
            <Label fx:id="lblContador" text="0 registro(s)" styleClass="contador-label"/>
            <Button text="✖ Cerrar" onAction="#volverInicio" styleClass="btn-cerrar"/>
        </HBox>
    </top>

    <!-- CENTER: tabla -->
    <center>
        <TableView fx:id="tablaPedidos" styleClass="tabla-principal">
            <columns>
                <TableColumn fx:id="colId"       text="ID"       prefWidth="50"  style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colCliente"  text="Cliente"  prefWidth="140"/>
                <TableColumn fx:id="colProducto" text="Producto" prefWidth="140"/>
                <TableColumn fx:id="colCantidad" text="Cant."    prefWidth="70"  style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colTotal"    text="Total"    prefWidth="100" style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colEstado"   text="Estado"   prefWidth="110" style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colFecha"    text="Fecha"    prefWidth="120"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="180" style="-fx-alignment:CENTER;"/>
            </columns>
            <placeholder><Label text="Sin pedidos registrados" styleClass="tabla-placeholder"/></placeholder>
        </TableView>
    </center>

    <!-- RIGHT: Formulario -->
    <right>
        <VBox spacing="14" styleClass="panel-form" prefWidth="280">
            <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>

            <Label fx:id="lblFormTitulo" text="✚  NUEVO PEDIDO" styleClass="form-titulo"/>
            <Separator/>

            <Label text="Cliente *" styleClass="form-label"/>
            <TextField fx:id="txtCliente" promptText="Nombre del cliente" styleClass="txt-field"/>

            <Label text="Producto *" styleClass="form-label"/>
            <TextField fx:id="txtProducto" promptText="Producto solicitado" styleClass="txt-field"/>

            <Label text="Cantidad" styleClass="form-label"/>
            <TextField fx:id="txtCantidad" promptText="0" styleClass="txt-field"/>

            <Label text="Total (S/.)" styleClass="form-label"/>
            <TextField fx:id="txtTotal" promptText="0.00" styleClass="txt-field"/>

            <Label text="Estado" styleClass="form-label"/>
            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" styleClass="cmb-field"/>

            <Label fx:id="lblMensaje" text="" wrapText="true" styleClass="msg-ok"/>

            <HBox spacing="8">
                <Button fx:id="btnGuardar" text="💾  Guardar" onAction="#guardar" styleClass="btn-guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="🗑 Limpiar" onAction="#limpiarFormulario" styleClass="btn-limpiar"/>
            </HBox>
        </VBox>
    </right>

</BorderPane>
